from tkinter import *
from tkinter import messagebox

root = Tk()
root.geometry("200x200")

def msg():
    messagebox.showwarning("Alert!, Stop Virus detected in your device. Take immediate action!!!")

button = Button(root, text = "Scan for viruses. Deleting the ones that exist!", command = msg)
button.place(x=40,y=80)

root.mainloop()
        
